# YouCam API credentials (https://yce.makeupar.com/api-console/en/api-keys/).
# Leave unset to run the server in deterministic mock mode.
YOUCAM_API_KEY=

# Base URL of the YouCam s2s API.
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com

# Shared demo token. When set, every /api request must carry it as the
# x-demo-token header. REQUIRED before exposing the server beyond localhost
# (HOST=0.0.0.0): without it anyone on the network can spend your paid
# render budget. Generate one with: openssl rand -hex 16
DEMO_TOKEN=

# Server bind (default localhost only; set 0.0.0.0 to expose on LAN —
# set DEMO_TOKEN above first).
HOST=127.0.0.1
PORT=8787

# Allowed browser origin for CORS (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173

# Total makeup renders allowed per session (initial 3 + shuffles/rebuilds).
# Default 9 = first build (3) + two shuffles (3+3).
RENDER_BUDGET=9

# Force mock mode even when an API key is present (dev).
YOUCAM_MOCK=0
